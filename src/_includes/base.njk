<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }} — {{ site.name }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>

<nav id="nav" class="nav-{{ navBg or 'yellow' }}">
  <div class="nav-pill">
    <a class="nav-logo-text" href="/">Sportswear X-Change</a>
    <ul class="nav-links">
      <li><a href="/" {% if navActive == 'home' %}class="active"{% endif %}>How it works</a></li>
      <li><a href="/about/" {% if navActive == 'about' %}class="active"{% endif %}>About</a></li>
      <li><a href="/get-involved/" {% if navActive == 'involved' %}class="active"{% endif %}>Get involved</a></li>
    </ul>
    <button class="nav-hamburger" aria-label="Menu" onclick="toggleNav()">
      <span></span><span></span><span></span>
    </button>
  </div>
  <a class="nav-join" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">Join our WhatsApp Group</a>
</nav>

{{ content | safe }}

<footer>
  <div class="footer-inner">
    <div class="footer-logo">
      <span class="footer-logo-text">Sportswear X-Change</span>
    </div>
    <nav class="footer-nav">
      <a href="/how-it-works/">How it works</a>
      <a href="/about/">About</a>
      <a href="/get-involved/">Get involved</a>
    </nav>
    <div class="footer-social">
      <a href="{{ site.facebook_url }}" target="_blank" rel="noopener">Facebook</a>
      <a href="{{ site.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
      <a href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</footer>

<script>
function toggleNav() {
  document.getElementById('nav').classList.toggle('open');
}
</script>
</body>
</html>
