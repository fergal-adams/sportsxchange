<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }} — {{ site.name }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>

<nav id="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/">Sportswear <span>X-Change</span></a>
    <ul class="nav-links">
      <li><a href="/" {% if navActive == 'home' %}class="active"{% endif %}>Home</a></li>
      <li><a href="/how-it-works/" {% if navActive == 'how' %}class="active"{% endif %}>How it works</a></li>
      <li><a href="/about/" {% if navActive == 'about' %}class="active"{% endif %}>About</a></li>
      <li><a href="/get-involved/" {% if navActive == 'involved' %}class="active"{% endif %}>Get involved</a></li>
    </ul>
    <a class="nav-cta" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">Join WhatsApp group</a>
    <button class="nav-hamburger" aria-label="Menu" onclick="toggleNav()">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<main>
  <div class="container">
    {{ content | safe }}
  </div>
</main>

<footer>
  <div class="container">
    <div class="footer-links">
      <a href="/get-involved/#contact">Contact</a>
      <a href="{{ site.facebook_url }}" target="_blank" rel="noopener">Facebook</a>
      <a href="{{ site.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
      <a href="/how-it-works/">How it works</a>
      <a href="/about/">About</a>
    </div>
    <p class="footer-copy">{{ site.name }} — a North Kerry Environmental Forum initiative.</p>
  </div>
</footer>

<script>
function toggleNav() {
  document.getElementById('nav').classList.toggle('open');
}
</script>
</body>
</html>
