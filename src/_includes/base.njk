<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }} — {{ site.name }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>

<nav id="nav">
  <div class="nav-inner">
    <div class="nav-pill">
      <a class="nav-logo-link" href="/"><img src="/assets/logo.svg" alt="Sportswear X-Change" class="nav-logo-img"></a>
      <ul class="nav-links">
        <li><a href="/how-it-works/" {% if navActive == 'how' %}class="active"{% endif %}>How it works</a></li>
        <li><a href="/about/" {% if navActive == 'about' %}class="active"{% endif %}>About</a></li>
        <li><a href="/get-involved/" {% if navActive == 'involved' %}class="active"{% endif %}>Get involved</a></li>
      </ul>
      <button class="nav-hamburger" aria-label="Menu" onclick="toggleNav()">
        <span></span><span></span><span></span>
      </button>
    </div>
    <a class="nav-join" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">Join our WhatsApp Group</a>
  </div>
</nav>

{{ content | safe }}

<footer>
  <div class="footer-top">
    <div class="footer-logo-area">
      <img src="/assets/footermark.svg" alt="Sportswear X-Change" class="footer-logo-img">
    </div>
    <nav class="footer-nav">
      <a href="/how-it-works/">How it works</a>
      <a href="/about/">About</a>
      <a href="/get-involved/">Get involved</a>
    </nav>
    <div class="footer-social">
      <a href="{{ site.facebook_url }}" target="_blank" rel="noopener">Facebook</a>
      <a href="{{ site.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
      <a href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
  <div class="footer-wordmark"><img src="/assets/footerlogobig.svg" alt="" aria-hidden="true" class="footer-wordmark-img"></div>
</footer>

<script>
function toggleNav() {
  document.getElementById('nav').classList.toggle('open');
}

(function () {
  var els = document.querySelectorAll('.js-scroll-tilt');
  if (!els.length) return;
  function update() {
    els.forEach(function (el) {
      var rect = el.getBoundingClientRect();
      var vh = window.innerHeight;
      // 0 when top of element is at bottom of viewport, 1 when fully scrolled past centre
      var progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
      el.style.transform = 'rotate(' + (progress * 5).toFixed(2) + 'deg)';
    });
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
}());
</script>
</body>
</html>
