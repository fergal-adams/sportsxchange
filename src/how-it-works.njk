---
layout: base.njk
pageTitle: "How it works"
pageDescription: "How to join, post items, browse, and collect through Sportswear X-Change."
navActive: how
permalink: /how-it-works/
---

<!-- Hero (blue) -->
<div class="hiw-hero">
  <div class="hiw-hero-inner">
    <div class="hiw-hero-text">
      <div class="hiw-hero-heading">HOW IT WORKS</div>
      <p class="hiw-hero-sub">{{ how_it_works.hero_intro }}</p>
      <a class="btn-whatsapp" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
        Join our WhatsApp Group
      </a>
    </div>
    <img src="/assets/jerseycollage2.jpg" alt="Sports jerseys for swap" class="hiw-hero-img js-scroll-tilt">
  </div>
</div>

<!-- 3 simple steps (cream) -->
<div class="hiw-steps-section">
  <div class="how-heading-row">
    <img src="/assets/X_Icon_Green.svg" class="section-ellipse" alt="" aria-hidden="true">
    <div class="how-heading">3 simple steps</div>
    <img src="/assets/X_Icon_Green.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="hiw-steps-grid">
    {% for step in how_it_works.steps %}
    <div class="hiw-step-col">
      <span class="hiw-step-num">0{{ step.num }}</span>
      <div class="hiw-step-title">{{ step.title }}</div>
      <p class="hiw-step-desc">{{ step.description }}</p>
    </div>
    {% endfor %}
  </div>
</div>

<!-- Drop-off points (blue-tint) -->
<div class="hiw-dropoff-section">
  <div class="how-heading-row">
    <img src="/assets/X_Icon_Green.svg" class="section-ellipse" alt="" aria-hidden="true">
    <div class="how-heading">PICK-UP POINTS</div>
    <img src="/assets/X_Icon_Green.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="dropoff-cards">
    {% for point in how_it_works.collection_points %}
    <div class="dropoff-card">
      <div class="dropoff-card-logo">
        {% if point.logo %}
        <img src="{{ point.logo }}" alt="{{ point.name }} logo">
        {% endif %}
      </div>
      <p class="dropoff-card-name">{{ point.name }}<br>{{ point.address }}</p>
    </div>
    {% endfor %}
  </div>
  <div class="dropoff-cta">
    <img src="/assets/infinity-white.svg" alt="" aria-hidden="true" class="dropoff-cta-icon">
    <div class="dropoff-cta-text">Want to get involved and become a Package Pick-Up Point?</div>
    <a class="dropoff-cta-btn" href="/get-involved/">Find out more →</a>
  </div>
</div>

<!-- Keep the circle going (cream) -->
<div class="hiw-circle-section">
  <div class="hiw-circle-inner">
    <div class="hiw-circle-text">
      <div class="hiw-circle-heading">{{ how_it_works.keep_circle_heading }}</div>
      <p class="hiw-circle-body">{{ how_it_works.keep_circle_text }}</p>
    </div>
    <div class="hiw-circle-img-wrap">
      <img src="/assets/X_Icon_Green.svg" alt="" aria-hidden="true" class="hiw-circle-icon">
      <img src="/assets/hero-2.jpg" alt="Keep good gear going" class="hiw-circle-img js-scroll-tilt">
    </div>
  </div>
</div>

<!-- FAQs (light-blue) -->
<div class="hiw-faq-section">
  <div class="how-heading-row">
    <img src="/assets/X_Icon_Green.svg" class="section-ellipse" alt="" aria-hidden="true">
    <div class="how-heading">FAQs</div>
    <img src="/assets/X_Icon_Green.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="hiw-faq-list">
    {% for faq in how_it_works.faqs %}
    <details class="faq-item">
      <summary class="faq-q">{{ faq.q }}</summary>
      <p class="faq-a">{{ faq.a }}</p>
    </details>
    {% endfor %}
  </div>
</div>
