---
layout: base.njk
pageTitle: "How it works"
pageDescription: "How to join, post items, browse, and collect through Sportswear X-Change."
navActive: how
navBg: blue
permalink: /how-it-works/
---

<div class="page-hero">
  <h1>How Sports X-Change Works</h1>
</div>

<!-- Steps -->
<div class="steps-section">
  <div class="steps-list">
    {% for step in how_it_works.steps %}
    <div class="step-item">
      <div class="step-rule"></div>
      <div class="step-row">
        <span class="step-num">0{{ step.num }}.</span>
        <div class="step-body">
          <div class="step-title">{{ step.title }}</div>
          <p class="step-desc">{{ step.description }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
    <div class="step-rule"></div>
  </div>

  <div class="steps-cta">
    <div class="steps-cta-text">Scan the code to join our WhatsApp!</div>
    <a class="nav-join-outline" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">Join our WhatsApp Group</a>
  </div>
</div>

<!-- Drop-off locations -->
<div class="locations-section section-blue">
  <div class="locations-rule"></div>
  <div class="locations-inner">
    <div class="locations-heading">Dropoff locations</div>
    <div class="locations-list">
      {% for point in how_it_works.collection_points %}
      <div class="location-name">{{ point }}</div>
      <div class="location-rule"></div>
      {% endfor %}
      <p class="t-body">{{ how_it_works.collection_points_note }} <a href="/get-involved/#businesses" style="text-decoration:underline;">Get in touch</a></p>
    </div>
  </div>
</div>

<!-- Rules -->
<div class="section-orange section-inner">
  <div class="step-rule" style="background:var(--plum)"></div>
  <div class="step-row" style="align-items:flex-start">
    <div style="flex:0 0 300px">
      <div class="t-display" style="color:var(--plum)">What can be swapped</div>
    </div>
    <ul style="flex:1;list-style:none;display:flex;flex-direction:column;gap:8px;">
      {% for item in how_it_works.what_can %}
      <li class="t-body" style="color:var(--plum)">— {{ item }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="step-rule" style="background:var(--plum)"></div>
  <div class="step-row" style="align-items:flex-start">
    <div style="flex:0 0 300px">
      <div class="t-display" style="color:var(--plum)">What can't be swapped</div>
    </div>
    <ul style="flex:1;list-style:none;display:flex;flex-direction:column;gap:8px;">
      {% for item in how_it_works.what_cannot %}
      <li class="t-body" style="color:var(--plum)">— {{ item }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="step-rule" style="background:var(--plum)"></div>
  <div class="step-row" style="align-items:flex-start">
    <div style="flex:0 0 300px">
      <div class="t-display" style="color:var(--plum)">Community expectations</div>
    </div>
    <p class="t-body" style="flex:1;color:var(--plum)">{{ how_it_works.community_rules }}</p>
  </div>
  <div class="step-rule" style="background:var(--plum)"></div>
</div>
