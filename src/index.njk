---
layout: base.njk
pageTitle: "Free sportswear for North Kerry families"
pageDescription: "Sportswear X-Change is a free community swap for North Kerry families. Donate outgrown sports kit, find what your child needs."
navActive: home
navBg: peach
---

<!-- Hero -->
<div class="hero-section">
  <div class="hero-display">
    <div class="hero-display-text">Meet&nbsp;&nbsp;<span class="hero-img-inline"><img src="/assets/hero-1.jpg" alt=""></span>&nbsp;&nbsp;Swap&nbsp;&nbsp;Move
Community&nbsp;&nbsp;<span class="hero-img-inline"><img src="/assets/hero-2.jpg" alt=""></span>&nbsp;&nbsp;Swap</div>
  </div>
  <div class="hero-intro">
    <img src="/assets/ellipse-stroke.svg" class="hero-leaf" alt="" aria-hidden="true">
    <p>{{ home.hero_subheading }}</p>
    <img src="/assets/ellipse-stroke-2.svg" class="hero-leaf" alt="" aria-hidden="true">
  </div>
</div>

<!-- Keeping good gear going -->
<div class="steps-section">
  <div>
    <div class="steps-headline">{{ home.intro_heading }}</div>
    <p class="steps-subtext">{{ home.intro_text }}</p>
  </div>

  <div class="steps-list">
    {% for step in home.steps %}
    <div class="step-item">
      <div class="step-rule"></div>
      <div class="step-row">
        <span class="step-num">0{{ step.num }}.</span>
        <div class="step-body">
          <div class="step-title">{{ step.title }}</div>
          <p class="step-desc">{{ step.description }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
    <div class="step-rule"></div>
  </div>

  <div class="steps-cta">
    <div class="steps-cta-text">Scan the code to join our WhatsApp!</div>
    <div class="steps-cta-right">
      <img src="/assets/qrcode.png" alt="Scan to join WhatsApp group" class="qr-code">
      <a class="nav-join-outline" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">Join our WhatsApp Group</a>
    </div>
  </div>
</div>

<!-- Drop-off locations -->
<div class="locations-section section-peach">
  <div class="locations-rule"></div>
  <div class="locations-inner">
    <div class="locations-heading">Dropoff locations</div>
    <div class="locations-list">
      {% for point in how_it_works.collection_points %}
      <div class="location-name">{{ point }}</div>
      <div class="location-rule"></div>
      {% endfor %}
      <p class="t-body">{{ how_it_works.collection_points_note }} <a href="/get-involved/#businesses" style="text-decoration:underline;">Get in touch</a></p>
    </div>
  </div>
</div>

<!-- Get involved banner -->
<div class="involved-banner section-peach">
  <div class="involved-card">
    <div class="involved-card-text">Want to get involved and become a dropoff location?</div>
    <a class="btn-outline-white" href="/get-involved/#businesses">Find out more →</a>
  </div>
</div>

<!-- Photo strip -->
<div class="photo-strip">
  <div class="photo-track">
    {% for i in range(0, 12) %}<div class="photo-tile"></div>{% endfor %}
    {% for i in range(0, 12) %}<div class="photo-tile"></div>{% endfor %}
  </div>
</div>

<!-- Who is this for? -->
<div class="blue-section">
  <div class="for-me-header">
    <span>{{ home.who_heading }}</span>
  </div>
  <p class="for-me-body">{{ home.who_text }}</p>
  <p class="who-sub">{{ home.who_sub }}</p>
</div>
