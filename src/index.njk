---
layout: base.njk
pageTitle: "Free sportswear for North Kerry families"
pageDescription: "Sportswear X-Change is a free community swap for North Kerry families. Donate outgrown sports kit, find what your child needs."
navActive: home
navBg: peach
---

<!-- Hero -->
<div class="hero-section">
  <img src="/assets/SportsXChange_WordMark_Logo_Colour.png" alt="Sports X Change" class="hero-wordmark">
  <div class="hero-intro">
    <p>{{ home.hero_subheading }}</p>
  </div>
  <img src="/assets/SportsXChange_Infinity_Logo_Black.svg" alt="" aria-hidden="true" class="hero-seam-logo">
</div>

<!-- Keeping good gear going -->
<div class="steps-section">
  <div class="steps-intro">
    <div class="steps-intro-text">
      <div class="steps-headline">{{ home.intro_heading }}</div>
      <div class="steps-subtext-group">
        <p class="steps-subtext">{{ home.intro_text }}</p>
        <p class="steps-subtext">{{ home.intro_text_2 }}</p>
      </div>
      <a class="btn-whatsapp" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
        Join our WhatsApp Group
      </a>
    </div>
    <img src="/assets/hero-1.jpg" alt="Sports gear swap" class="steps-intro-img js-scroll-tilt">
  </div>
</div>

<!-- How does it work? -->
<div class="how-section">
  <div class="how-heading-row">
    <img src="/assets/X_Icon_Blue.svg" class="section-ellipse" alt="" aria-hidden="true">
    <div class="how-heading">HOW DOES IT WORK?</div>
    <img src="/assets/X_Icon_Blue.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="how-steps-grid">
    {% for step in home.steps %}
    <div class="how-step-col">
      <div class="step-rule"></div>
      <div class="step-row">
        <span class="step-num">0{{ step.num }}</span>
        <div class="step-body">
          <div class="step-title">{{ step.title }}</div>
          <p class="step-desc">{{ step.description }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
    <div class="step-rule"></div>
  </div>
  <div class="how-read-more">
    <a class="nav-join-outline" href="/how-it-works/">Read more about how it works →</a>
  </div>
</div>

<!-- Drop-off locations -->
<div class="dropoff-section">
  <div class="how-heading-row">
    <img src="/assets/X_Icon_Blue.svg" class="section-ellipse" alt="" aria-hidden="true">
    <div class="how-heading">PICK-UP POINTS</div>
    <img src="/assets/X_Icon_Blue.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="dropoff-cards">
    {% for point in how_it_works.collection_points %}
    <div class="dropoff-card">
      <div class="dropoff-card-logo">
        {% if point.logo %}
        <img src="{{ point.logo }}" alt="{{ point.name }} logo">
        {% endif %}
      </div>
      <p class="dropoff-card-name">{{ point.name }}<br>{{ point.address }}</p>
    </div>
    {% endfor %}
  </div>
  <div class="dropoff-cta">
    <img src="/assets/community-symbol.svg" alt="" aria-hidden="true" class="dropoff-cta-icon">
    <div class="dropoff-cta-text">Want to get involved and become a pick-up point?</div>
    <a class="dropoff-cta-btn" href="/get-involved/">Find out more →</a>
  </div>
</div>

<!-- Scan the code to join WhatsApp -->
<div class="scan-banner">
  <div class="scan-banner-inner">
    <div class="scan-banner-heading">SCAN THE CODE TO JOIN OUR WHATSAPP!</div>
    <img src="/assets/qrcode.png" alt="Scan QR code to join WhatsApp group" class="scan-banner-qr">
  </div>
</div>

<!-- Who is this for? -->
<div class="who-section">
  <div class="who-text">
    <div class="who-heading">{{ home.who_heading }}</div>
    <p class="who-body">{{ home.who_text }}</p>
    <p class="who-body">{{ home.who_sub }}</p>
    <a class="nav-join-outline who-btn" href="/about/">Learn more about us →</a>
  </div>
  <div class="who-img-wrap">
    <img src="/assets/hero-2.jpg" alt="Sports gear swap community" class="who-img js-scroll-tilt">
    <div class="who-card">
      <p class="who-card-text">{{ home.who_attribution }}</p>
      <div class="who-card-logos">
        <img src="/assets/logo-nkef.png" alt="North Kerry Environmental Forum">
      </div>
    </div>
  </div>
</div>
