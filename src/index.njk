---
layout: base.njk
pageTitle: "Free sportswear for North Kerry families"
pageDescription: "Sportswear X-Change is a free community swap for North Kerry families. Donate outgrown sports kit, find what your child needs."
navActive: home
navBg: peach
---

<!-- Hero -->
<div class="hero-section">
  <img src="/assets/logo.svg" alt="Sports X Change" class="hero-wordmark">
  <div class="hero-intro">
    <img src="/assets/ellipse-stroke.svg" class="hero-leaf" alt="" aria-hidden="true">
    <p>{{ home.hero_subheading }}</p>
    <img src="/assets/ellipse-stroke-2.svg" class="hero-leaf" alt="" aria-hidden="true">
  </div>
</div>

<!-- Keeping good gear going -->
<div class="steps-section">
  <div class="steps-intro">
    <div class="steps-intro-text">
      <div class="steps-headline">{{ home.intro_heading }}</div>
      <p class="steps-subtext">{{ home.intro_text }}</p>
      <a class="nav-join-outline" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener">Join our WhatsApp Group</a>
    </div>
    <img src="/assets/hero-1.jpg" alt="Sports gear swap" class="steps-intro-img">
  </div>
</div>

<!-- How does it work? -->
<div class="how-section">
  <div class="how-heading-row">
    <img src="/assets/ellipse-stroke.svg" class="section-ellipse" alt="" aria-hidden="true">
    <div class="how-heading">HOW DOES IT WORK?</div>
    <img src="/assets/ellipse-stroke-2.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="how-steps-grid">
    {% for step in home.steps %}
    <div class="how-step-col">
      <div class="step-rule"></div>
      <div class="step-row">
        <span class="step-num">0{{ step.num }}</span>
        <div class="step-body">
          <div class="step-title">{{ step.title }}</div>
          <p class="step-desc">{{ step.description }}</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="how-read-more">
    <a class="nav-join-outline" href="/how-it-works/">Read more about how it works →</a>
  </div>
</div>

<!-- Drop-off locations -->
<div class="dropoff-section">
  <div class="dropoff-top">
    <div class="dropoff-rule"></div>
    <div class="dropoff-inner">
      <div class="dropoff-heading">Dropoff<br>Locations</div>
      <div class="dropoff-list">
        {% for point in how_it_works.collection_points %}
        <p class="dropoff-name"><strong>{{ point.name }}</strong><br>{{ point.address }}</p>
        {% if not loop.last %}<div class="dropoff-item-rule"></div>{% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="dropoff-cta">
    <div class="dropoff-cta-text">Want to get involved and become a dropoff location?</div>
    <a class="dropoff-cta-btn" href="/get-involved/#businesses">Find out more →</a>
  </div>
</div>

<!-- Photo strip -->
<div class="photo-strip">
  <div class="photo-track">
    {% for i in range(0, 12) %}<div class="photo-tile"></div>{% endfor %}
    {% for i in range(0, 12) %}<div class="photo-tile"></div>{% endfor %}
  </div>
</div>

<!-- Who is this for? -->
<div class="who-section">
  <div class="who-text">
    <div class="who-heading">{{ home.who_heading }}</div>
    <p class="who-body">{{ home.who_text }}</p>
    <p class="who-body">{{ home.who_sub }}</p>
    <a class="nav-join-outline" href="/about/">Learn more →</a>
  </div>
  <img src="/assets/hero-2.jpg" alt="Sports gear swap community" class="who-img">
</div>
