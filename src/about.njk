---
layout: base.njk
pageTitle: "About"
pageDescription: "Why Sportswear X-Change exists — removing cost as a barrier to sport, reducing waste, and strengthening community in North Kerry."
navActive: about
navBg: green
permalink: /about/
---

<!-- Page hero -->
<div class="page-hero section-green">
  <div class="page-hero-inner">
    <h1>About Sportswear X-Change</h1>
  </div>
</div>

<!-- Our story -->
<div class="section-yellow">
  <div class="section-inner">
    <div class="row">
      <span class="t-label" style="color:var(--green);">Our story</span>
      <div class="row-content">
        {% for para in about.story %}
        <p class="t-body" style="color:var(--green);">{{ para }}</p>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<!-- Why this matters -->
<div class="section-green">
  <div class="section-inner">
    <div class="row">
      <span class="t-label" style="color:var(--yellow-mid);">Why this matters</span>
      <div class="row-content">
        {% for card in about.cards %}
        <div>
          <p class="t-heading" style="color:var(--yellow);">{{ card.title }}</p>
          <p class="t-body" style="color:var(--yellow-mid); margin-top:12px;">{{ card.text }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<!-- SDG -->
<div class="section-yellow">
  <div class="section-inner">
    <div class="row">
      <span class="t-label" style="color:var(--green);">Circular economy &amp; SDG 12</span>
      <div class="row-content">
        {% for para in about.sdg_text %}
        <p class="t-body" style="color:var(--green);">{{ para }}</p>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<!-- NKEF -->
<div class="section-green">
  <div class="section-inner">
    <div class="row">
      <span class="t-label" style="color:var(--yellow-mid);">About NKEF</span>
      <div class="row-content">
        {% for para in about.nkef_text %}
        <p class="t-body" style="color:var(--yellow-mid);">{{ para }}</p>
        {% endfor %}
        <div><a class="btn btn-yellow" href="{{ site.facebook_url }}" target="_blank" rel="noopener">Visit NKEF on Facebook</a></div>
      </div>
    </div>
  </div>
</div>
