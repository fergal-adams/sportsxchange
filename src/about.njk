---
layout: base.njk
pageTitle: "About"
pageDescription: "Why Sportswear X-Change exists — removing cost as a barrier to sport, reducing waste, and strengthening community in North Kerry."
navActive: about
navBg: peach
permalink: /about/
---

<!-- Page hero (peach) -->
<div class="page-hero section-peach">
  <div class="page-hero-inner">
    <div class="page-hero-display">About<br>Sports<br>X-Change.</div>
    <div style="flex:1;display:flex;flex-direction:column;gap:20px;padding-bottom:12px;">
      {% for para in about.story %}
      <p class="page-hero-sub">{{ para }}</p>
      {% endfor %}
      <a class="nav-join-outline" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener" style="align-self:flex-start">Join our WhatsApp Group</a>
    </div>
  </div>
</div>

<!-- Why this matters (orange) -->
<div class="section-orange section-inner">
  <div class="steps-headline-centered">
    <img src="/assets/ellipse-stroke.svg" class="section-ellipse" alt="" aria-hidden="true">
    <span>Why this matters</span>
    <img src="/assets/ellipse-stroke-2.svg" class="section-ellipse" alt="" aria-hidden="true">
  </div>
  <div class="why-cards-row">
    {% for card in about.cards %}
    <div class="why-card-col">
      <div class="step-rule" style="background:var(--plum)"></div>
      <div class="t-display" style="color:var(--plum);margin:20px 0 12px;">{{ card.title }}</div>
      <p class="t-body" style="color:var(--plum)">{{ card.text }}</p>
    </div>
    {% endfor %}
  </div>
</div>

<!-- Circular living (blue) -->
<div class="section-blue section-inner">
  <div class="step-rule" style="background:var(--plum)"></div>
  <div class="step-row" style="align-items:flex-start">
    <div class="t-display" style="flex:0 0 300px;color:var(--plum)">{{ about.sdg_heading }}</div>
    <div style="flex:1;display:flex;flex-direction:column;gap:20px;">
      {% for para in about.sdg_text %}
      <p class="t-body" style="color:var(--plum)">{{ para }}</p>
      {% endfor %}
      <div><a class="btn btn-plum" href="https://circular.ie" target="_blank" rel="noopener">Learn more at Circular.ie →</a></div>
    </div>
  </div>
  <div class="step-rule" style="background:var(--plum)"></div>
</div>

<!-- About NKEF (peach) -->
<div class="section-peach section-inner">
  <div class="step-rule" style="background:var(--plum)"></div>
  <div class="step-row" style="align-items:flex-start">
    <div class="t-display" style="flex:0 0 300px;color:var(--plum)">About NKEF</div>
    <div style="flex:1;display:flex;flex-direction:column;gap:20px;">
      {% for para in about.nkef_text %}
      <p class="t-body" style="color:var(--plum)">{{ para }}</p>
      {% endfor %}
      <div><a class="btn btn-green" href="{{ site.facebook_url }}" target="_blank" rel="noopener">Ballybunion NKEF Facebook →</a></div>
    </div>
  </div>
  <div class="step-rule" style="background:var(--plum)"></div>
</div>
