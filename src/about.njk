---
layout: base.njk
pageTitle: "About"
pageDescription: "Why Sportswear X-Change exists — removing cost as a barrier to sport, reducing waste, and strengthening community in North Kerry."
navActive: about
navBg: peach
permalink: /about/
---

<!-- Page hero (light blue) -->
<div class="page-hero" style="background: var(--light-blue)">
  <div class="page-hero-inner">
    <div class="page-hero-display">About<br>Sports<br>X-Change.</div>
    <div style="flex:1;display:flex;flex-direction:column;gap:20px;padding-bottom:12px;">
      {% for para in about.story %}
      <p class="page-hero-sub">{{ para }}</p>
      {% endfor %}
      <a class="nav-join-outline" href="{{ site.whatsapp_url }}" target="_blank" rel="noopener" style="align-self:flex-start">Join our WhatsApp Group</a>
    </div>
  </div>
</div>

<!-- About NKEF (peach) -->
<div class="section-peach section-inner">
  <div class="step-rule" style="background:var(--plum)"></div>
  <div class="step-row" style="align-items:flex-start">
    <div class="t-display" style="flex:0 0 300px;color:var(--plum)">About NKEF</div>
    <div style="flex:1;display:flex;flex-direction:column;gap:20px;">
      {% for para in about.nkef_text %}
      <p class="t-body" style="color:var(--plum)">{{ para }}</p>
      {% endfor %}
      <div><a class="btn btn-green" href="/why-this-matters/" rel="noopener">Read more about why we're doing this project here →</a></div>
    </div>
  </div>
  <div class="step-rule" style="background:var(--plum)"></div>
</div>
